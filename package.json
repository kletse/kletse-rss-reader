{
  "name": "kletse-rss",
  "private": true,
  "version": "3.1.2",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "check": "tsc --noEmit",
    "vite:dev": "vite",
    "vite:build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "lint": "biome check && npm run lint:rust",
    "lint:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml --check && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "format": "biome check --write && cargo fmt --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/literata": "5.3.0",
    "@tauri-apps/api": "2.12.4",
    "dompurify": "3.4.17",
    "highlight.js": "11.12.0",
    "solid-js": "1.9.18"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@solidjs/testing-library": "0.8.10",
    "@tauri-apps/cli": "2.12.4",
    "jsdom": "30.1.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vite-plugin-solid": "2.11.15",
    "vitest": "5.0.5"
  }
}
