{
  "name": "kletse-rss",
  "private": true,
  "version": "1.1.1",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build --no-bundle",
    "check": "tsc --noEmit",
    "vite:dev": "vite",
    "vite:build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "lint": "cargo fmt --manifest-path src-tauri/Cargo.toml --check && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@tauri-apps/api": "2.12.4",
    "dompurify": "3.4.17",
    "highlight.js": "11.12.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "jsdom": "30.1.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
