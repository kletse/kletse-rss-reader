# Maintainer: Ward <ward@kletse.be>
# Builds from this local checkout: cd packaging && makepkg -si
pkgname=kletse-rss
pkgver=5.2.0
pkgrel=1
pkgdesc="A one-article-at-a-time Miniflux reader for Omarchy"
arch=('x86_64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-svg' 'qt6-imageformats' 'qt6-wayland')
makedepends=('cargo' 'lld') # cxx-qt links with ld.gold without lld, which fails since the lib/bin split
options=('!lto' '!debug') # cargo does the LTO; makepkg's would also reach the C++ of the Qt bridge

_root() { realpath "$startdir/.."; }

build() {
  cd "$(_root)"
  cargo build --release --locked
  # The terminal version, built apart so that it doesn't link Qt.
  cargo build --release --locked --no-default-features --features tui
}

package() {
  local root; root="$(_root)"
  install -Dm755 "$root/target/release/kletse-rss" "$pkgdir/usr/bin/kletse-rss"
  install -Dm755 "$root/target/release/kletse-rss-tui" "$pkgdir/usr/bin/kletse-rss-tui"
  install -Dm644 "$root/packaging/kletse-rss.desktop" "$pkgdir/usr/share/applications/kletse-rss.desktop"
  install -Dm644 "$root/packaging/kletse-rss.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/kletse-rss.svg"
  install -Dm644 "$root/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
